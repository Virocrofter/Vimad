{
  "name": "unified-pms",
  "private": true,
  "version": "0.0.0",
  "description": "Unified PMS — property management SaaS",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "turbo run test --filter=@unified-pms/web --filter=@unified-pms/shared",
    "test:all": "turbo run test",
    "test:api": "cd apps/api && npx vitest run",
    "test:web": "turbo run test --filter=@unified-pms/web",
    "test:shared": "turbo run test --filter=@unified-pms/shared"
  },
  "devDependencies": {
    "@turbo/gen": "^2.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "lint": "^1.2.2",
    "npm": "^11.19.1",
    "run": "^2.1.4"
  }
}
