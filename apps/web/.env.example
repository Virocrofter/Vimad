# ─────────────────────────────────────────────────────────────────────────────
# Vimad PMS — Web Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust for local development:
#   cp apps/web/.env.example apps/web/.env
#
# Vite exposes only variables prefixed with VITE_ to the client.
# Never put secrets here — anything with VITE_ is bundled into the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the API the frontend talks to.
# Dev default: http://localhost:3001 (the API port)
VITE_API_URL=http://localhost:3001

# Sentry DSN for browser error tracking. [OPTIONAL]
# VITE_SENTRY_DSN=

# Force the frontend to use mock data instead of hitting the API.
# Useful for UI work offline. [OPTIONAL]
# VITE_USE_MOCK_DATA=false