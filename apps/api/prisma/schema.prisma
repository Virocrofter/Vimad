  beos Beo[]

  @@index([tenantId])
  @@map("sc_av_packages")
}

model SetupStyle {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  icon      String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beos Beo[]

  @@index([tenantId])
  @@map("sc_setup_styles")
}

model DecorOption {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  unit      String   @default("each")
  icon      String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("sc_decor_options")
}

model ScActivity {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String?
  client    ScClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventId   String?
  event     ScEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String   // call | email | meeting | note | status_change
  body      String
  createdById String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([clientId])
  @@index([eventId])
  @@map("sc_activities")
