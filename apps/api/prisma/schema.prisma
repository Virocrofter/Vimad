// ─── T7: Meal plans — board basis packages, restaurants, assignments & posting log ───

model Restaurant {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  type           String     @default("main") // main | pool | specialty | bar | room_service
  cuisine        String?
  capacity       Int        @default(50)
  operatingHours String? // "06:00 - 22:00"
  location       String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  mealPlans MealPlan[]

  @@unique([propertyId, name])
  @@index([tenantId])
  @@map("restaurants")
}

model MealPlan {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  code         String // unique per property, e.g. HB-PREM
  boardBasis   String      @default("BB") // RO | BB | HB | FB | AI | UAI
  price        Decimal     @db.Decimal(10, 2) // per adult per day
  currency     String      @default("ZAR")
  taxInclusive Boolean     @default(true)
  autoPost     Boolean     @default(true)
  postTime     String      @default("06:00") // HH:MM property-local — the auto-post deadline
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  description  String?
  inclusions   String[]    @default([])
  exclusions   String[]    @default([])
  childUnder6  String      @default("free") // free | 50 | 75 | full | n/a
  childUnder12 String      @default("50")
  childUnder16 String      @default("75")
  seasonality  String      @default("year-round")
  startDate    DateTime?   @db.Date // seasonal window (null = year-round)
  endDate      DateTime?   @db.Date
  isActive     Boolean     @default(true)

  assignments MealPlanAssignment[]

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId, isActive])
  @@map("meal_plans")
}

model MealPlanAssignment {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  mealPlanId    String
  mealPlan      MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  adults        Int      @default(2)
  children      Int      @default(0)
  dailyRate     Decimal  @db.Decimal(10, 2) // snapshot at assignment time — later plan edits never rewrite history
  status        String   @default("active") // active | cancelled
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  postings MealPlanPosting[]

  @@index([tenantId, status])
  @@index([reservationId])
  @@index([startDate, endDate])
  @@map("meal_plan_assignments")
}

// One row per assignment per day — the unique key makes the auto-poster
// idempotent: the scanner can run forever and never double-post a meal.
model MealPlanPosting {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   MealPlanAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  amount       Decimal  @db.Decimal(10, 2)
  status       String   @default("pending") // pending | posted | failed | skipped
  folioItemId  String? // set once the folio charge exists — re-post guard
  error        String?
  retryCount   Int      @default(0)
  postedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([assignmentId, date])
  @@index([tenantId, status])
  @@index([date])
  @@map("meal_plan_postings")
}

// ─── SUPPORT: ticketing with SLA, escalation & CSAT ───
// One thread per issue. Messages carry isInternal for staff-only notes.
// SLA clock: response due (first staff message) and resolve due, both by
// priority. The tickets job scans every 5 min, flags breaches and escalates.

model Ticket {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  guestId       String?
  guest         Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  number      String // TKT-2026-0001 — sequential per tenant
  source      String @default("guest_portal") // guest_portal | staff | email
  subject     String
  description String
  category    String @default("general")
  status      String @default("open") // open | in_progress | waiting_guest | resolved | closed
  priority    String @default("medium") // low | medium | high | urgent

  assigneeId String?
  assignee   User?  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy  User?  @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)

  slaResponseDueAt DateTime?
  slaResolveDueAt  DateTime?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  slaBreached      Boolean  @default(false)
  escalationLevel  Int      @default(0) // 0 none | 1 breached | 2 management

  satisfactionRating  Int?
  satisfactionComment String?

  lastMessageAt DateTime @default(now())
  messages      TicketMessage[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, assigneeId, status])
  @@index([guestId])
  @@index([slaResponseDueAt])
  @@index([slaResolveDueAt])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType String // guest | staff | system
  authorId   String?
  authorName String
  body       String
  isInternal Boolean  @default(false) // staff-only note — filtered from guest API
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketCounter {
  tenantId   String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("ticket_counters")
}