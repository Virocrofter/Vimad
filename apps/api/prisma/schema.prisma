  id         String   @id
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type       String
  payload    Json?
  actor      String
  createdAt  DateTime @default(now())

  @@index([contractId, createdAt])
  @@map("contract_events")
}

model UsageLedger {
  id             String   @id
  tenantId       String
  metric         String
  quantity       Int
  unit           String
  period         String
  unitCost       Decimal? @db.Decimal(12, 6)
  ratedAmount    Decimal? @db.Decimal(12, 2)
  status         String   @default("pending")
  invoiceId      String?
  idempotencyKey String?
  metadata       Json?
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("usage_ledger")
}

model SupportAccessRequest {
  id          String    @id
  caseId      String
  tenantId    String
  requestedBy String
  scope       String    @default("read_only")
  purpose     String
  status      String    @default("pending")
  expiresAt   DateTime?
  approvedBy  String?
  createdAt   DateTime  @default(now())

  @@map("support_access_requests")
}

model DataRequest {
  id          String    @id
  tenantId    String
  type        String
  purpose     String
  requestedBy String
  status      String    @default("pending")
  result      Json?
  expiresAt   DateTime?
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  @@index([tenantId, status])
  @@map("data_requests")
}

model RetentionPolicy {
  id        String   @id
  dataClass String
  tenantId  String?
  schedule  Json
  legalHold Boolean  @default(false)
  holdReason String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([dataClass, tenantId])
  @@map("retention_policies")
}

model BackupRun {
  id                String    @id
  kind              String
  status            String
  destination       String
  sizeBytes         BigInt?
  checksum          String?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  actor             String?
  restoreTestedAt   DateTime?
  restoreTestStatus String?
  restoreTestLog    String?
  @@map("backup_runs")
}

model DemoSession {
  id             String    @id @default(cuid())
  tenantId       String?
  requesterEmail String
  status         String    @default("pending")
  grantedBy      String?
  activatedAt    DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokeReason   String?
  company        String?
  hotelName      String?
  roomCount      Int?
  currentPms     String?
  preferredSlot  String?
  notes          String?
  firstLoginAt   DateTime?
  lastActivityAt DateTime?
  activityCount  Int       @default(0)
  convertedAt    DateTime?
  extendedCount  Int       @default(0)
  createdAt      DateTime  @default(now())

  invites        DemoInvite[]
  activity       DemoActivity[]

  @@map("demo_sessions")
}

model DemoInvite {
  id          String      @id @default(cuid())
  sessionId   String
  session     DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash   String
  tokenPrefix String
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String?
  createdAt   DateTime    @default(now())

  @@index([sessionId])
  @@index([tokenHash])
  @@map("demo_invites")
}

model DemoActivity {
  id         String      @id @default(cuid())
  sessionId  String
  session    DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenantId   String?
  actor      String?
  action     String
  detail     String?
  meta       Json?
  createdAt  DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("demo_activity")
}





model FeedbackEntry {
  id        String   @id
  tenantId  String?
  source    String   @default("admin")
  npsScore  Int?
  body      String?
  category  String   @default("general")
  status    String   @default("new")
  assignee  String?
  createdAt DateTime @default(now())
  @@map("feedback_entries")
}

model Incident {
  id                String    @id
  severity          String
  title             String
  status            String    @default("investigating")
  affectedTenantIds Json      @default("[]")
  timeline          Json      @default("[]")
  startedAt         DateTime  @default(now())
  resolvedAt        DateTime?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@map("incidents")
}

model WebhookDelivery {
  id           String    @id
  connectionId String
  event        String
  payloadHash  String
  status       String    @default("queued")
  attempts     Int       @default(0)
  lastError    String?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  @@index([status, createdAt])
  @@map("webhook_deliveries")
}

model PlatformAnnouncement {
  id        String   @id
  title     String
  body      String
  audience  String   @default("all_operators")
  status    String   @default("draft")
  publishAt DateTime @default(now())
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("platform_announcements")
}

model ApiClient {
  id          String   @id
  name        String
  contactEmail String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("api_clients")
}

model IntegrationCatalogEntry {
  key          String   @id
  name         String
  category     String
  availability String   @default("planned")
  notes        String?
  updatedAt    DateTime @updatedAt
  @@map("integration_catalog")
}

model AccessReview {
  id         String   @id
  period     String
  operatorId String
  reviewedBy String
  outcome    String
  notes      String?
  createdAt  DateTime @default(now())
  @@unique([period, operatorId])
  @@map("access_reviews")
}

model MetricDefinition {
  key        String   @id
  title      String
  definition String
  numerator  String
  denominator String
  source     String
  owner      String
  caveats    String?
  updatedAt  DateTime @updatedAt
  @@map("metric_definitions")
}
