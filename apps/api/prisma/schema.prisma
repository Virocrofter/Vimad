model ScEvent {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  clientId     String?
  client       ScClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name         String
  type         String    @default("corporate") // wedding | corporate | social | conference | banquet
  status       String    @default("lead") // lead | quoted | contracted | confirmed | in_progress | completed | cancelled | lost
  eventDate    DateTime  @db.Date
  startTime    String?   // HH:MM
  endTime      String?
