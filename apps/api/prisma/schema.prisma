generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant & Identity ───

model Tenant {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  plan                String               @default("trial")
  isDemo              Boolean              @default(false)
  status              String               @default("active")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  properties          Property[]
  users               User[]
  guests              Guest[]
  reservations        Reservation[]
  roomTypes           RoomType[]
  rooms               Room[]
  ratePlans           RatePlan[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  invoices            Invoice[]
  taxInvoices         TaxInvoice[]
  invoiceCounters     InvoiceCounter[]
  contracts           Contract[]
  pushSubscriptions   PushSubscription[]
  channelConnections  ChannelConnection[]
  housekeepingTasks   HousekeepingTask[]
  nightAudits         NightAudit[]
  nightAuditSchedules NightAuditSchedule[]
  payments              Payment[]
  guestPaymentMethods   GuestPaymentMethod[]
  paymentRequests       PaymentRequest[]
  emailLogs             EmailLog[]
  tasks     Task[]
  taskRules TaskRule[]
  conciergeItems      ConciergeItem[]
  parkingBays         ParkingBay[]
  guestVehicles       GuestVehicle[]
  parkingAssignments  ParkingAssignment[]
  chains              Chain[]
  groups              Group[]
  inventoryRestrictions InventoryRestriction[]
  inventoryAllocations  InventoryAllocation[]
  corporateAccounts      CorporateAccount[]
  guestFollowUps         GuestFollowUp[]
  guestSegments          GuestSegment[]
  guestSegmentMemberships GuestSegmentMembership[]
  restaurants         Restaurant[]
  mealPlans           MealPlan[]
  mealPlanAssignments MealPlanAssignment[]
  mealPlanPostings    MealPlanPosting[]
  tickets             Ticket[]
  arInvoices         ArInvoice[]
  arPayments         ArPayment[]
  arInvoiceCounters  ArInvoiceCounter[]
  reservationTraces      ReservationTrace[]
  reservationCompanions  ReservationCompanion[]
  scClients           ScClient[]
  scEvents            ScEvent[]
  beos                Beo[]
  venues              Venue[]
  menuPackages        MenuPackage[]
  avPackages          AvPackage[]
  setupStyles         SetupStyle[]
  decorOptions        DecorOption[]
  scActivities        ScActivity[]
  cannedResponses    CannedResponse[]
  guestIdentityGroups GuestIdentityGroup[]
  supportCases       SupportCase[]
  onboardingImports OnboardingImport[]
  propertyTemplates PropertyTemplate[]
  loyaltyConfig      LoyaltyConfig?
  folioSplitRequests FolioSplitRequest[]
  loyaltyRewards     LoyaltyReward[]
  loyaltyRedemptions LoyaltyRedemption[]
  reservationModificationRequests ReservationModificationRequest[]
  exceptions          Exception[]
  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?   // T5: WhatsApp/SMS task push destination (E.164)
  role         String   @default("staff")
  status       String   @default("active")
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastPropertyId String? // C1: sticky property-switcher choice (validated in service layer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  roleAssignments   RoleAssignment[]
  housekeepingTasks HousekeepingTask[] @relation("AssignedTasks")
  inspectedTasks    HousekeepingTask[] @relation("InspectedTasks")
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  guestNotes        GuestNote[]
  minibarChecks MinibarCheck[]
  assignedTasks     Task[] @relation("TaskAssignees")
  conciergeItems    ConciergeItem[]
  scManagedClients  ScClient[] @relation("SC_AccountManager")
  scOwnedEvents     ScEvent[]  @relation("SC_EventOwner")
  assignedTickets     Ticket[] @relation("TicketAssignee")
  createdTickets      Ticket[] @relation("TicketCreator")
  cannedResponses      CannedResponse[]
  supportCasesAssigned SupportCase[] @relation("SupportCaseAssignee")
  supportCasesCreated  SupportCase[] @relation("SupportCaseCreator")


  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── C1: Chains — a tenant's properties grouped under one login ───

model Chain {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("chains")
}

// ─── Refresh Token (with revocation support) ───

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Password Reset ───

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

// ─── Property & Inventory ───

model Property {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  code                String
  address             String?
  city                String?
  country             String?
  vatNumber          String?
  chainId            String?
  chain              Chain?   @relation(fields: [chainId], references: [id], onDelete: SetNull)
  timezone            String   @default("UTC")
  currency            String   @default("ZAR")
  status              String   @default("active")
  billClosingRule     String   @default("always")
  billClosingWindowHours Int   @default(12)
  tomsaLevyEnabled    Boolean  @default(false)
  tomsaLevyPct        Decimal  @default(1) @db.Decimal(5, 2)
  currentBusinessDate DateTime @default(now()) @db.Date
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  roomTypes           RoomType[]
  rooms               Room[]
  ratePlans           RatePlan[]
  reservations        Reservation[]
  channelConnections  ChannelConnection[]
  housekeepingTasks   HousekeepingTask[]
  nightAudits         NightAudit[]
  nightAuditSchedules NightAuditSchedule[]
  taxInvoices         TaxInvoice[]
  tasks     Task[]
  taskRules TaskRule[]
  conciergeItems      ConciergeItem[]
  parkingBays         ParkingBay[]
  parkingAssignments  ParkingAssignment[]
  groups              Group[]
  inventoryRestrictions InventoryRestriction[]
  inventoryAllocations  InventoryAllocation[]
  restaurants         Restaurant[]
  mealPlans           MealPlan[]
  tickets             Ticket[]
  venues              Venue[]
  scEvents            ScEvent[]
  arInvoices          ArInvoice[]
  loyaltyTransactions LoyaltyTransaction[]
  accountingConfig      AccountingConfig?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("properties")
}

model RoomType {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  code          String
  description   String?
  baseOccupancy Int      @default(2)
  maxOccupancy  Int      @default(4)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms     Room[]
  ratePlans RatePlan[]
  groupBlocks GroupRoomBlock[]
  reservations Reservation[]
  inventoryRestrictions InventoryRestriction[]
  inventoryAllocations  InventoryAllocation[]
  inventoryOverbooking  InventoryOverbooking?
  inventoryDailyCache   InventoryDailyCache[]

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
  @@map("room_types")
}

model Room {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId         String
  roomType           RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  number             String
  floor              String?
  status             String   @default("clean")
  housekeepingStatus String   @default("ready")
  serviceStatus      String   @default("active")
  serviceReason      String?
  parentRoomId       String?
  statusChangedAt    DateTime?
  statusChangedBy    String?
  parentRoom         Room?    @relation("RoomCascade", fields: [parentRoomId], references: [id], onDelete: SetNull)
  childRooms         Room[]   @relation("RoomCascade")
  statusEvents       RoomStatusEvent[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reservationStays  ReservationStay[]
  housekeepingTasks HousekeepingTask[]
  tasks Task[]
  minibarChecks MinibarCheck[]
  conciergeItems      ConciergeItem[]

  @@unique([propertyId, number])
  @@index([tenantId])
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([propertyId, serviceStatus])
  @@map("rooms")
}
model RoomStatusEvent {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  field      String
  from       String?
  to         String
  reason     String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([tenantId, propertyId, createdAt])
  @@index([roomId, createdAt])
  @@map("room_status_events")
}


model RatePlan {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId        String
  roomType          RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name              String
  code              String
  description       String?
  baseRate          Decimal   @db.Decimal(10, 2)
  currency          String    @default("ZAR")
  calculationMethod String    @default("fixed") // fixed | percent | amount
  parentRatePlanId  String?
  commissionPct     Decimal? @db.Decimal(5, 2)
  calculationValue  Decimal?  @db.Decimal(10, 2)
  advanceDays       Int?
  startDate         DateTime?
  endDate           DateTime?
  minStay           Int?
  maxStay           Int?
  closeToArrival    Boolean   @default(false)
  closeToDeparture  Boolean   @default(false)
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reservations Reservation[]

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
  @@index([roomTypeId])
  @@map("rate_plans")
}

// ─── Guests ───

model Guest {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  nationality     String?
  address         String?
  city            String?
  country         String?
  passportNumber  String?
  loyaltyPoints   Int       @default(0)
  vipStatus       String?
  doNotDisturb    Boolean   @default(false)
  blacklisted     Boolean   @default(false)
  blacklistReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reservations        Reservation[]
  preferences         GuestPreference[]
  documents           GuestDocument[]
  guestNotes          GuestNote[]
  loyaltyTransactions LoyaltyTransaction[]
  payments            Payment[]
  paymentMethods      GuestPaymentMethod[]
  taxInvoices         TaxInvoice[]
  tasks Task[]
  conciergeItems      ConciergeItem[]
  vehicles            GuestVehicle[]
  tags                String[]             @default([])
  corporateAccountId  String?
  corporateAccount    CorporateAccount?    @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  crmFollowUps        GuestFollowUp[]
  segmentMemberships  GuestSegmentMembership[]
  tickets             Ticket[]
  reservationCompanions ReservationCompanion[]
  identityMemberships GuestIdentityMember[]
  loyaltyRedemptions  LoyaltyRedemption[]
  consents            GuestConsent[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("guests")
}

model GuestPreference {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  category  String
  key       String
  value     String
  createdAt DateTime @default(now())

  @@index([guestId])
  @@map("guest_preferences")
}

model GuestDocument {
  id         String    @id @default(cuid())
  guestId    String
  guest      Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  type       String
  number     String?
  issuedBy   String?
  issueDate  DateTime?
  expiryDate DateTime?
  fileUrl    String?
  verificationStatus String   @default("pending") // pending | verified | rejected
  verifiedAt         DateTime?
  verifiedById       String?
  createdAt  DateTime  @default(now())

  @@index([guestId])
  @@map("guest_documents")
}

model GuestNote {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
  tenantId  String
  pinned    Boolean  @default(false)

  @@index([tenantId, guestId, createdAt])
  @@index([guestId])
  @@map("guest_notes")
}

// ─── Reservations ───

model Reservation {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId            String
  guest              Guest    @relation(fields: [guestId], references: [id], onDelete: Restrict)
  confirmationNumber String   @unique
  groupId            String?
  group              Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  roomTypeId         String?
  roomType           RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  ratePlanId         String?
  ratePlan           RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  status             String   @default("confirmed")
  source             String   @default("direct")
  arrivalDate        DateTime @db.Date
  departureDate      DateTime @db.Date
  nights             Int
  adults             Int      @default(1)
  children           Int      @default(0)
  notes              String?
  eta                String?
  specialRequests    String?
  marketSegment      String?
  houseUse           Boolean  @default(false)
  guaranteed         Boolean  @default(false)
  doNotMove          Boolean  @default(false)
  fixedRoom          Boolean  @default(false)
  depositDue         Decimal  @default(0) @db.Decimal(10, 2)
  depositPaid        Decimal  @default(0) @db.Decimal(10, 2)
  preArrivalSentAt   DateTime?
  confirmationSentAt DateTime?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  checkedInBy        String?
  checkedOutBy       String?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancelReason       String?
  noShowAt           DateTime?
  totalAmount        Decimal  @db.Decimal(10, 2)
  balance            Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stays ReservationStay[]
  folio Folio?
  payments              Payment[]
  paymentRequests       PaymentRequest[]
  taxInvoices         TaxInvoice[]
  tasks Task[]
  minibarChecks MinibarCheck[]
  conciergeItems      ConciergeItem[]
  mealPlanAssignments MealPlanAssignment[]
  tickets             Ticket[]
  traces              ReservationTrace[]
  companions          ReservationCompanion[]
  modificationRequests ReservationModificationRequest[]
  splitRequests      FolioSplitRequest[]
  redemptions        LoyaltyRedemption[]
  guestOrders        GuestOrder[]
  chatThreads        ChatThread[]
  reviews            Review[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([guestId])
  @@index([status])
  @@index([arrivalDate, departureDate])
  @@index([tenantId, status, arrivalDate])
  @@index([tenantId, propertyId, status])
  @@index([ratePlanId])
  @@index([tenantId, arrivalDate])
  @@map("reservations")
}

model ReservationStay {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  rate          Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  @@unique([reservationId, roomId, date])
  @@index([roomId, date])
  @@index([date])
  @@index([reservationId])
  @@map("reservation_stays")
}

// ─── Billing ───

model Folio {
  id            String      @id @default(cuid())
  reservationId String?     @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tenantId      String
  status        String      @default("open")
  closedAt      DateTime?
  closedBy      String?
  groupId       String?
  isMaster      Boolean     @default(false)
  totalCharges  Decimal     @default(0) @db.Decimal(10, 2)
  totalPayments Decimal     @default(0) @db.Decimal(10, 2)
  balance       Decimal     @default(0) @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items    FolioItem[]
  payments Payment[]
  taxInvoices         TaxInvoice[]

  @@index([status])
  @@index([tenantId, status, createdAt])
  @@index([groupId])
  @@map("folios")
}

model FolioItem {
  id          String   @id @default(cuid())
  folioId     String
  folio       Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  type        String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1)
  postedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  movedFromFolioId String?
  movedAt   DateTime?
  movedBy   String?

  @@index([folioId])
  @@map("folio_items")
}

model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  periodStart   DateTime  @db.Date
  periodEnd     DateTime  @db.Date
  dueDate       DateTime  @db.Date
  plan          String
  baseAmount    Decimal   @db.Decimal(10, 2)
  overageAmount Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal   @db.Decimal(10, 2)
  currency      String    @default("ZAR")
  status        String    @default("draft")
  paidAt        DateTime?
  billingPeriod String?
  items         Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

// ─── Channel Manager ───

model ChannelConnection {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider       String
  hotelId        String
  apiKey         String
  apiSecret      String?
  endpoint       String?
  settings       Json      @default("{}")
  status         String    @default("pending")
  lastSyncStatus String?
  lastSyncAt     DateTime?
  connectedAt    DateTime?
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  mappings ChannelMapping[]

  @@unique([tenantId, propertyId, provider, hotelId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("channel_connections")
}

model ChannelMapping {
  id                  String            @id @default(cuid())
  channelConnectionId String
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  roomTypeId          String?
  ratePlanId          String?
  externalRoomTypeId  String?
  externalRatePlanId  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([channelConnectionId])
  @@map("channel_mappings")
}

// ─── Housekeeping ───

model HousekeepingTask {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId            String
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type              String    @default("cleaning")
  priority          String    @default("normal")
  status            String    @default("pending")
  scheduledAt       DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  estimatedDuration Int?
  actualDuration    Int?
  notes             String?
  checklist         String[]  @default([])
  assigneeId        String?
  assignee          User?     @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  inspectorId       String?
  inspector         User?     @relation("InspectedTasks", fields: [inspectorId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([propertyId])
  @@index([roomId])
  @@index([status])
  @@index([scheduledAt])
  @@index([tenantId, status, scheduledAt])
  @@map("housekeeping_tasks")
}

// ─── Night Audit ───

model NightAudit {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  auditDate    DateTime  @db.Date
  status       String    @default("in_progress")
  runBy        String
  steps        Json      @default("{}")
  results      Json?
  errorMessage String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, propertyId, auditDate])
  @@index([tenantId])
  @@index([propertyId])
  @@index([auditDate])
  @@index([status])
  @@map("night_audits")
}

// ─── Night Audit Automation ───

model NightAuditSchedule {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  scheduledTime String    @default("02:00")
  timezone      String    @default("UTC")
  isActive      Boolean   @default(true)
  autoRun       Boolean   @default(false)
  steps         Json      @default("{}")
  notifyEmails  String[]  @default([])
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([propertyId])
  @@index([nextRunAt])
  @@index([isActive])
  @@map("night_audit_schedules")
}

// ─── Audit & Ops ───

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─── Notifications ───

model Notification {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String
  category String

  title   String
  message String

  actionUrl   String?
  actionLabel String?

  entityType String?
  entityId   String?

  read   Boolean   @default(false)
  readAt DateTime?

  deliveredVia String[] @default([])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Push Subscriptions (for Web Push) ───

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  endpoint String
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([tenantId])
  @@map("push_subscriptions")
}

// ─── RBAC: Roles ───

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("custom")
  isDefault   Boolean  @default(false)
  isLocked    Boolean  @default(false)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@index([tenantId])
  @@map("roles")
}

// ─── RBAC: Permissions (Resource + Action Matrix) ───

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?
  category    String  @default("general")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// ─── RBAC: Role-Permission Junction ───

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  conditions   Json?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─── RBAC: User-Role Assignment (with property scope) ───

model RoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  propertyId String?
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, propertyId])
  @@index([userId])
  @@index([roleId])
  @@map("role_assignments")
}

// ─── API Keys with Scoped Permissions ───

model ApiKey {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  keyHash      String
  keyPrefix    String
  scopes       String[]
  status       String    @default("active")
  environment  String    @default("production")
  rateLimit    String    @default("1000/min")
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  usageCount   Int       @default(0)
  createdBy    String?
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([keyPrefix])
  @@index([status])
  @@map("api_keys")
}

// ─── Idempotency Keys ───

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String   @unique
  scope       String
  requestPath String?
  requestBody Json?
  payload     Json?
  response    Json?
  status      String   @default("pending")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─── Reports ───

model ReportTemplate {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  description String?
  category    String   @default("custom")
  type        String   @default("custom")
  config      Json     @default("{}")
  fields      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scheduledReports ScheduledReport[]
  reportRuns       ReportRun[]

  @@index([tenantId])
  @@map("report_templates")
}

model ScheduledReport {
  id         String         @id @default(cuid())
  templateId String
  template   ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  frequency  String
  recipients String[]
  format     String
  parameters Json           @default("{}")
  nextRunAt  DateTime
  lastRunAt  DateTime?
  status     String         @default("active")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([templateId])
  @@index([nextRunAt])
  @@map("scheduled_reports")
}

model ReportRun {
  id          String         @id @default(cuid())
  reportId    String
  template    ReportTemplate @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status      String         @default("pending")
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  rowCount    Int            @default(0)
  fileKey     String?
  fileUrl     String?
  error       String?
  createdAt   DateTime       @default(now())

  @@index([reportId])
  @@index([status])
  @@map("report_runs")
}

// ─── Dead Letter Queue Persistence ───

model FailedJob {
  id           String    @id @default(cuid())
  queue        String
  jobId        String
  jobName      String
  payload      Json?
  failReason   String
  attemptCount Int       @default(0)
  status       String    @default("pending")
  retriedAt    DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([queue, jobId])
  @@index([status])
  @@map("failed_jobs")
}

// ─── Usage Metering ───

model UsageRecord {
  id         String   @id @default(cuid())
  tenantId   String
  metric     String
  quantity   Int      @default(1)
  recordedAt DateTime @default(now())
  metadata   Json?

  @@index([recordedAt])
  @@index([tenantId, metric, recordedAt])
  @@map("usage_records")
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  type        String
  amount      Int
  balance     Int
  description String
  source      String   @default("Manual")
  createdById String?
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([guestId])
  @@index([tenantId, createdAt])
  @@index([propertyId])
  @@map("loyalty_transactions")
}

// ─── Payments (Paystack) ───

model Payment {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String?
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestId       String?
  guest         Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  folioId       String?
  folio         Folio?       @relation(fields: [folioId], references: [id], onDelete: SetNull)

  reference         String  @unique
  paystackId        BigInt?
  authorizationCode String?
  channel           String  @default("card")
  cardLast4         String?
  cardBrand         String?

  amountMinor   Int
  currency      String @default("ZAR")
  feeMinor      Int    @default(0)
  refundedMinor Int    @default(0)

  type           String
  status         String    @default("pending")
  idempotencyKey String?   @unique
  failureReason  String?
  metadata       Json?
  postedToFolio     Boolean  @default(false)
  postedAt          DateTime?
  createdById       String?
  paymentRequest    PaymentRequest?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status, type])
  @@index([reservationId])
  @@index([guestId])
  @@index([folioId])
  @@map("payments")
}

model GuestPaymentMethod {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guestId              String
  guest                Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  paystackCustomerCode String?
  authorizationCode    String
  cardType             String?
  cardLast4            String
  cardExpMonth         String?
  cardExpYear          String?
  bank                 String?
  channel              String   @default("card")
  reusable             Boolean  @default(true)
  isDefault            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@unique([guestId, authorizationCode])
  @@index([tenantId])
  @@index([guestId])
  @@map("guest_payment_methods")
}

// ─── Payment Requests ───

model PaymentRequest {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestId       String?
  folioId       String?
  paymentId     String?      @unique
  payment       Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  reference           String  @unique
  paystackRequestCode String?
  paystackOfflineRef  String?
  hostedUrl           String?

  amountMinor Int
  currency    String  @default("ZAR")
  status      String  @default("pending")
  description String?

  depositPercent       Int       @default(50)
  dueDate              DateTime
  sentAt               DateTime?
  paidAt               DateTime?
  remindersSent        Int       @default(0)
  nextReminderAt       DateTime?
  reminderOffsetsHours Int[]     @default([])

  autoCancelEnabled    Boolean   @default(false)
  autoCancelAt         DateTime?
  reservationCancelled Boolean   @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([nextReminderAt])
  @@index([reservationId])
  @@map("payment_requests")
}

// ─── Transactional email log ───

model EmailLog {
  id          String    @id @default(cuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  to          String
  subject     String
  template    String
  payload     Json?
  status      String    @default("queued")
  error       String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([relatedType, relatedId])
  @@map("email_logs")
}

// [A5] SARS-compliant tax invoices & receipts
model TaxInvoice {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  folioId       String?
  folio         Folio?   @relation(fields: [folioId], references: [id])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  guestId       String?
  guest         Guest?   @relation(fields: [guestId], references: [id])
  paymentId     String?  @unique
  originalId    String?
  original      TaxInvoice?  @relation("CreditNotes", fields: [originalId], references: [id])
  creditNotes   TaxInvoice[] @relation("CreditNotes")
  originalNumber String?
  reason        String?

  number        String
  type          String
  status        String   @default("open")
  currency      String   @default("ZAR")

  subtotalExVat Decimal  @db.Decimal(12, 2)
  vatRate       Decimal  @default(15.00) @db.Decimal(5, 2)
  vatAmount     Decimal  @db.Decimal(12, 2)
  totalInclVat  Decimal  @db.Decimal(12, 2)
  amountPaid    Decimal  @default(0) @db.Decimal(12, 2)

  propertyName  String
  propertyVatNo String?
  guestName     String
  guestEmail    String?

  issueDate     DateTime @default(now())
  pdfPath       String?
  sentAt        DateTime?

  items         TaxInvoiceItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, number])
  @@index([folioId])
  @@index([reservationId])
  @@map("tax_invoices")
}

model TaxInvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal    @default(1) @db.Decimal(10, 2)
  unitPriceEx Decimal    @db.Decimal(12, 2)
  vatRate     Decimal    @default(15.00) @db.Decimal(5, 2)
  amountEx    Decimal    @db.Decimal(12, 2)

  @@map("tax_invoice_items")
}

// [A5] Sequential numbering
model InvoiceCounter {
  tenantId   String   @id
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("invoice_counters")
}

// ─── T1: Universal Task model + Rules engine ───

model Task {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  department    String
  title         String
  description   String?
  status        String       @default("open")
  priority      String       @default("normal")
  roomId        String?
  room          Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guestId       String?
  guest         Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignee      User?        @relation("TaskAssignees", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueAt       DateTime?
  slaMinutes  Int?
  slaBreached Boolean  @default(false)

  ruleId    String?
  rule      TaskRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleKey   String?
  ruleAudit Json?

  entityType String?
  entityId   String?

  dedupeKey String?
  source    String  @default("manual")

  metadata    Json?

  pushToken          String?   @unique
  pushTokenExpiresAt DateTime?
  pushChannel        String?
  pushSentAt         DateTime?
  pushAttempts       Int       @default(0)
  completedAt DateTime?

  completedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status])
  @@index([tenantId, department, status])
  @@index([propertyId, status, dueAt])
  @@index([assigneeId, status])
  @@index([ruleId])
  @@index([status, slaBreached])
  @@index([tenantId, ruleId, entityType, entityId])
  @@map("tasks")
}

model TaskRule {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  key         String
  name        String
  department  String
  description String?
  trigger     Json     @default("{}")
  conditions  Json     @default("{}")
  action      Json     @default("{}")
  config      Json     @default("{}")
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  lastRunCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]

  @@unique([tenantId, key])
  @@map("task_rules")
}

// ─── T2: Minibar checks ───

model MinibarCheck {
  id            String       @id @default(cuid())
  tenantId      String
  propertyId    String
  roomId        String
  room          Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  folioItemId   String?
  status        String       @default("logged")
  items         Json         @default("[]")
  totalMinor    Int          @default(0)
  photos        String[]     @default([])
  note          String?
  loggedById    String?
  loggedBy      User?        @relation(fields: [loggedById], references: [id], onDelete: SetNull)
  postedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, createdAt])
  @@index([roomId])
  @@index([reservationId])
  @@index([status])
  @@map("minibar_checks")
}

// ─── T3: Concierge board ───

model ConciergeItem {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type          String
  status        String   @default("open")
  title         String
  description   String?
  guestId       String?
  guest         Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignee      User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?
  completedAt DateTime?

  priceMinor Int    @default(0)
  currency   String @default("ZAR")

  flightNumber String?
  tripStatus   String?

  postedToFolio Boolean   @default(false)
  folioItemId   String?
  postedAt      DateTime?

  dedupeKey String?
  source    String  @default("manual")
  metadata  Json?

  loyaltyRedemptions LoyaltyRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status])
  @@index([propertyId, status, scheduledAt])
  @@index([type])
  @@index([reservationId])
  @@index([guestId])
  @@map("concierge_items")
}

// ─── T4: Parking board ───

model ParkingBay {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label          String
  zone           String   @default("standard")
  status         String   @default("available")
  evCharger      Boolean  @default(false)
  chargingStatus String   @default("free")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments ParkingAssignment[]

  @@unique([propertyId, label])
  @@index([tenantId])
  @@index([propertyId, status])
  @@map("parking_bays")
}

model GuestVehicle {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  plate      String
  make       String?
  model      String?
  color      String?
  isElectric Boolean  @default(false)
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments ParkingAssignment[]

  @@unique([tenantId, plate])
  @@index([guestId])
  @@map("guest_vehicles")
}

model ParkingAssignment {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bayId         String
  bay           ParkingBay  @relation(fields: [bayId], references: [id], onDelete: Cascade)
  vehicleId     String
  vehicle       GuestVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  reservationId String?

  status      String    @default("scheduled")
  valet       Boolean   @default(false)
  valetInstructions String?
  valetKeyLocation  String?
  plateAtCheckin    String?

  assignedBy   String?
  scheduledFor DateTime @db.Date
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  dedupeKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status])
  @@index([propertyId, status, scheduledFor])
  @@index([vehicleId])
  @@index([reservationId])
  @@map("parking_assignments")
}

// ─── G1: Groups & room blocks ───

model Group {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  company       String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  blockType     String   @default("courtesy")
  status        String   @default("prospect")
  arrivalDate   DateTime @db.Date
  departureDate DateTime @db.Date
  cutOffDate    DateTime? @db.Date
  rate          Decimal? @db.Decimal(10, 2)
  eventSpace    String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roomBlocks   GroupRoomBlock[]
  reservations Reservation[]
  charges      GroupCharge[]
  payments     GroupPayment[]
  events       GroupEvent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, propertyId, status])
  @@index([tenantId, arrivalDate])
  @@map("groups")
}

model GroupRoomBlock {
  id           String   @id @default(cuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roomTypeId   String
  roomType     RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  roomsBlocked Int
  rate         Decimal? @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([groupId])
  @@map("group_room_blocks")
}

model GroupCharge {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type        String   @default("misc")
  description String
  amount      Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1)
  postedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([groupId])
  @@map("group_charges")
}

model GroupPayment {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  method     String   @default("bank_transfer")
  amount     Decimal  @db.Decimal(10, 2)
  reference  String?
  note       String?
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([groupId])
  @@map("group_payments")
}

model GroupEvent {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  venue     String?
  date      DateTime @db.Date
  startTime String?
  endTime   String?
  guests    Int      @default(0)
  status    String   @default("tentative")
  tags      String[] @default([])
