model Beo {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId            String
  event              ScEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  version            Int       @default(1)
  status             String    @default("draft") // draft | pending_approval | approved | signed | changes_requested
  title              String
  eventDate          DateTime  @db.Date
  startTime          String?
  endTime            String?
  guestCount         Int       @default(0)
  venueId            String?
  venue              Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  setupId            String?
  setup              SetupStyle? @relation(fields: [setupId], references: [id], onDelete: SetNull)
  menuId             String?
  menu               MenuPackage? @relation(fields: [menuId], references: [id], onDelete: SetNull)
  avId               String?
  av                 AvPackage? @relation(fields: [avId], references: [id], onDelete: SetNull)
  priceOverrides     Json      @default("{}") // { room?, setup?, menu?, av? }
  additionalServices Json      @default("[]") // [{ name, price }]
  decor              Json      @default("[]") // [{ optionId, qty }]
  specialInstructions String?
  logistics          Json      @default("{}") // { loadIn, loadOut, floristAccess, contactName, contactPhone }
  snapshots          Json      @default("{}") // denormalized catalog copies at version time
  signatures         Json      @default("[]") // [{ name, role, signedAt, ip }]
  createdById        String?
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@map("sc_beos")
