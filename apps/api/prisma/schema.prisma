// ─── I1: Sellable room inventory — availability engine ───
// Availability per room type per date =
//   physical rooms − out-of-order − active holds (+ manual adjustment)
//   + overbooking allowance − occupied (active reservation stays).
// Restrictions (stop-sell / CTA / CTD / adjustment) are one row per
// room-type per date; allocations are per-date holds (group blocks,
// channel allotments, maintenance blocks).

model InventoryRestriction {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  stopSell         Boolean @default(false)
  closeToArrival   Boolean @default(false)
  closeToDeparture Boolean @default(false)
  adjustment       Int     @default(0) // manual +N/-N sellable units for this date

  notes       String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roomTypeId, date])
  @@index([tenantId, propertyId, date])
  @@map("inventory_restrictions")
}

model InventoryAllocation {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  type     String // group_hold | channel_allotment | maintenance_block | comp_hold
  name     String
  quantity Int

  status        String    @default("active") // active | released
  reservationId String?
  notes         String?
  dedupeKey     String? // generators can re-run forever without double-holding
  createdById   String?
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([roomTypeId, date])
  @@index([tenantId, status])
  @@map("inventory_allocations")
}

model InventoryDailyCache {
  propertyId      String
  roomTypeId      String
  roomType        RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  total           Int
  ooo             Int
  occupied        Int
  held            Int
  adjustment      Int
  sellable        Int
  overbookingLimit Int
  remaining       Int
  computedAt      DateTime @default(now())

  @@id([propertyId, roomTypeId, date])
  @@index([roomTypeId, date])
  @@map("inventory_daily_cache")
}

model InventoryOverbooking {
  roomTypeId  String   @id
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  limit       Int      @default(0) // extra sellable units above physical inventory
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("inventory_overbooking")
}



model CorporateAccount {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  email          String?
  phone          String?
  negotiatedRate Decimal? @db.Decimal(10, 2)
  notes          String?
  isActive       Boolean  @default(true)
  guests         Guest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  scClientId     String?
  scClient       ScClient? @relation(fields: [scClientId], references: [id], onDelete: SetNull)

  @@index([tenantId, scClientId])
  @@index([tenantId, name])
  @@map("corporate_accounts")
}

model GuestFollowUp {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guestId     String
  guest       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  assigneeId  String
  title       String
  dueAt       DateTime?
  doneAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([tenantId, assigneeId, doneAt])
  @@map("guest_follow_ups")
}

model GuestSegment {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rule        Json
  isActive    Boolean                  @default(true)
  memberCount Int                      @default(0)
  lastRunAt   DateTime?
  memberships GuestSegmentMembership[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([tenantId, isActive])
  @@map("guest_segments")
}

model GuestSegmentMembership {
