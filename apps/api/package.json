    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
