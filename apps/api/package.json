{
  "name": "@unified-pms/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test DATABASE_URL=postgresql://vimad:vimad_dev_password@localhost:5432/unified_pms REDIS_URL=redis://localhost:6379 JWT_SECRET=test-secret-key-for-testing-min-32-chars RATE_LIMIT_ENABLED=false vitest run",
    "test:unit": "NODE_ENV=test DATABASE_URL=postgresql://vimad:vimad_dev_password@localhost:5432/unified_pms REDIS_URL=redis://localhost:6379 JWT_SECRET=test-secret-key-for-testing-min-32-chars RATE_LIMIT_ENABLED=false vitest run --exclude \"tests/e2e/**\" --exclude \"tests/integration/**\"",
    "test:integration": "NODE_ENV=test vitest run tests/integration tests/e2e",
    "test:e2e": "NODE_ENV=test vitest run tests/e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
