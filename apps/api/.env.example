# ─────────────────────────────────────────────────────────────────────────────
# Vimad PMS — API Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values marked REQUIRED.
#   cp apps/api/.env.example apps/api/.env
#
# Legend:
#   [REQUIRED]  — must be set or the server refuses to start (env.ts validation)
#   [PROD]      — required in production; has a safe dev default otherwise
#   [OPTIONAL]  — safe to omit; sensible default or feature disabled
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core ───

# Node environment. Drives defaults, logging format, and hardening checks.
# dev default: development | prod: production
NODE_ENV=development

# HTTP port the API listens on.
# dev default: 3001
PORT=3001

# PostgreSQL connection string (Prisma).
# [REQUIRED] — no default. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vimad?schema=public

# Secret used to sign JWT access tokens AND local-storage file signatures.
# [REQUIRED] — min 32 characters. Generate with:
#   openssl rand -base64 48
# dev default: 'dev-secret-change-in-production' (never use in prod)
JWT_SECRET=92cefe2cf2aeb43d2416a0b3f9f580434f3da7b80722246cf5851cbab3f6b85f

# Public URL of the web frontend. Used for CORS, password-reset links, and
# emails. In dev the Vite dev server runs on 5173.
# dev default: http://localhost:5173
WEB_URL=http://localhost:5173

# Public URL of this API. Used to build signed download links for exports.
# dev default: http://localhost:3001
API_PUBLIC_URL=http://localhost:3001

# ─── Redis (job queues, rate limiting, socket.io adapter) ───

# [PROD] Without Redis, rate limiting falls back to in-memory (single-process
# only) and background jobs (email, reports, night audit, billing, GDPR) will
# not run. Dev default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Separate Redis for the rate limiter. Falls back to REDIS_URL if unset.
# [OPTIONAL]
# RATE_LIMIT_REDIS_URL=

# ─── Logging ───

# Pino log level.
# dev default: info | options: trace debug info warn error fatal
LOG_LEVEL=info

# ─── Rate Limiting ───

# Master switch for all rate limiters. Set to 'false' only in tests.
# dev default: true
RATE_LIMIT_ENABLED=true

# ─── External Services ───

# Stripe (billing). Health check pings Stripe when the key is present.
# [OPTIONAL] — billing features disabled without it
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# SendGrid API key. Only needed when EMAIL_PROVIDER=sendgrid.
# [OPTIONAL]
# SENDGRID_API_KEY=

# Sentry error tracking. [PROD] strongly recommended.
# [OPTIONAL]
# SENTRY_DSN=

# ─── Email ───

# Provider: smtp | sendgrid | ses
# dev default: smtp (points at MailHog on localhost:1025 — see README)
EMAIL_PROVIDER=smtp

# SMTP settings (used by 'smtp' and 'ses' providers).
# dev defaults: localhost:1025 (MailHog), no auth, no TLS
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# From address for all outbound mail.
# dev default: Vimad <no-reply@vimad.io>
EMAIL_FROM=Vimad <no-reply@vimad.io>

# Ops inbox for dead-letter alerts (jobs that failed permanently).
# dev default: ops@vimad.io
# OPS_EMAIL=ops@vimad.io

# ─── Channel Manager ───

# Timeout (ms) for outbound channel-manager HTTP calls.
# dev default: 15000
CHANNEL_API_TIMEOUT_MS=15000

# ─── SMS (Twilio) ───

# [OPTIONAL] — SMS features disabled without these
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=          # must be E.164, e.g. +15551234567
# TWILIO_STATUS_CALLBACK_URL=   # https URL Twilio POSTs delivery status to

# ─── File Storage ───

# local — files on disk under STORAGE_LOCAL_DIR, served via HMAC-signed URLs
# s3    — S3 or S3-compatible (MinIO) with presigned URLs
# dev default: local | [PROD] use s3
STORAGE_PROVIDER=local

# Directory for STORAGE_PROVIDER=local. Relative to apps/api/ at runtime.
# dev default: ./storage
STORAGE_LOCAL_DIR=./storage

# TTL (seconds) for signed export/report download links.
# dev default: 86400 (24h)
EXPORT_URL_TTL_SECONDS=86400

# S3 settings — only needed when STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                  # e.g. http://localhost:9000 for MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true      # required for MinIO

# ─── PDF Rendering ───

# Path to a Chromium/Chrome binary for puppeteer-core (report PDFs).
# The API Dockerfile installs chromium at this path.
# dev default: /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ─── Web Push (VAPID) ───

# [OPTIONAL] — push notifications disabled without these
# Generate keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@vimad.io

# ─── CORS ───

# Comma-separated list of allowed browser origins.
# In development, localhost:5173 and localhost:3000 are always allowed.
# In production this MUST be set — otherwise only WEB_URL is allowed.
# Example: https://app.vimad.io,https://admin.vimad.io
# CORS_ORIGINS=

# ─── Metrics (Prometheus) ───

# Optional shared secret for GET /metrics. When set, scrapes must send
#   Authorization: Bearer <METRICS_BEARER_TOKEN>
# Prefer network-level controls (private ingress) in production; this is a
# second layer only.
# [OPTIONAL]
# METRICS_BEARER_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Test-only variables (not read by the running server — used by Vitest /
# Playwright helpers directly). Declared in env.ts so tests can access them
# through the same validated object.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres for integration/e2e tests. When set (or RUN_DB_TESTS=true),
# DB-backed tests run; otherwise they are skipped.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vimad_test?schema=public
# RUN_DB_TESTS=true

# Set to 'true' in CI pipelines. Skips dev-only conveniences in test helpers.
# CI=true

# Playwright e2e targets — read by playwright.config.ts, NOT by env.ts.
# Set these in apps/api/.env or export them before running e2e tests.
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# PLAYWRIGHT_API_URL=http://localhost:3001


# ─── Docs protection (production only) ───
# If unset in production, /api-docs and /openapi.json return 404.
DOCS_USERNAME=docs-admin
DOCS_PASSWORD=fbf197cb878f1bad151e8112398357652ef52b8ec66464c7d1298878477cf342

# ─── Metrics scrape protection (production only) ───
# If unset in production, /metrics returns 401.
# Prometheus scrape config: authorization: Bearer <this token>
METRICS_BEARER_TOKEN=5e10453c4a9fd0f25a69491a436fd0e0083fa7efa1ade68ca8128a98d96269c9