# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unified_pms"

# Redis
REDIS_URL="redis://localhost:6379"

# API
PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:5173
API_URL=http://localhost:3001
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173
# Secret for signing JWTs — must be at least 32 characters in production
JWT_SECRET=

# Auth (Auth0 / Clerk / etc.)
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@unifiedpms.example

# Object storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
# Email address for operational alerts (e.g. dead-letter queue notifications)
OPS_EMAIL=ops@vimad.io

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vimad.io

